# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Project Settings → API). La clave anon es pública: la seguridad la dan las políticas RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon

# Opcional: Client ID de Google (termina en .apps.googleusercontent.com). Con él se usa
# el botón oficial de Google y la pantalla de Google muestra el dominio de la web.
# Sin él, el ingreso con Google pasa por la pantalla con el dominio de Supabase.
VITE_GOOGLE_CLIENT_ID=
